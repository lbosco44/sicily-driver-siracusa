---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../components/Hero.astro';
import FAQ from '../components/FAQ.astro';
import CTAForm from '../components/CTAForm.astro';
import WhatsAppSticky from '../components/WhatsAppSticky.astro';

const faqs = [
  {
    q: 'Do you provide Taormina – Catania Airport transfer?',
    a: 'Yes, with flight monitoring and flexible timing. The driver waits at arrivals.',
  },
  {
    q: 'Can we combine Etna + Taormina in one day?',
    a: 'Absolutely. Typical plan 6–8 hours with customized stops.',
  },
];
---

<LandingLayout
  url="/driver-taormina"
  faqs={faqs}
  lang="en"
  service={{ name: 'Private Driver Taormina', areaServed: 'Taormina', description: 'Private driver in Taormina with Catania airport transfer and Etna tour. Premium Mercedes, VIP service.' }}
>
  <Hero
    lang="en"
    compact={true}
    h1="Private Driver Taormina – Luxury Transfers & Etna Tour"
    tagline="Private driver to/from Taormina with transfers from Catania Airport, Siracusa and the Ionian coast. Add an Etna wine-tasting tour with scenic stops."
  />

  <section class="bg-deep-space-blue-900 py-20 md:py-32">
    <div class="max-w-[1360px] mx-auto px-5 md:px-10">
      <div class="max-w-3xl">
        <div class="mb-10">
          <a href="/en/contatti" class="inline-flex items-center gap-2 bg-golden-bronze-500 hover:bg-golden-bronze-600 text-white font-medium px-8 py-4 rounded-sm transition-colors duration-200">
            Contact your driver
          </a>
        </div>
        <h2 class="font-display text-parchment-50 font-medium text-[clamp(22px,3vw,38px)] tracking-tight mb-8">
          Why choose our private driver in Taormina
        </h2>
        <ul class="space-y-4 mb-16">
          {[
            'Catania Airport → Taormina / Giardini Naxos',
            'Etna Experience with wine tasting',
            'Premium vehicles with professional driver',
            'VIP service for hotels and weddings',
          ].map((item) => (
            <li class="flex items-start gap-4 text-parchment-100 text-lg">
              <span class="w-1.5 h-1.5 rounded-full bg-golden-bronze-500 mt-2.5 flex-shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <FAQ faqs={faqs} lang="en" dark={true} />

  <section class="bg-deep-space-blue-950 py-12">
    <div class="max-w-[1360px] mx-auto px-5 md:px-10 text-center">
      <a href="/en/contatti" class="inline-flex items-center gap-2 bg-golden-bronze-500 hover:bg-golden-bronze-600 text-white font-medium px-8 py-4 rounded-sm transition-colors duration-200">
        Get a quote in Taormina
      </a>
    </div>
  </section>

  <CTAForm lang="en" />
  <WhatsAppSticky lang="en" />
</LandingLayout>
