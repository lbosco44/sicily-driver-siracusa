---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FAQ from '../components/FAQ.astro';
import CTAForm from '../components/CTAForm.astro';
import WhatsAppSticky from '../components/WhatsAppSticky.astro';

const faqs = [
  {
    q: 'Possiamo personalizzare le soste?',
    a: 'Sì, ogni tour è modulabile: foto-spot, tempo libero, degustazioni e visite guidate su richiesta.',
  },
  {
    q: 'Quanto dura un tour tipico?',
    a: 'Da 6 a 9 ore in base al percorso. Per itinerari più lunghi possiamo estendere a giornata intera.',
  },
  {
    q: 'Sono disponibili seggiolini per bambini?',
    a: 'Certo, basta richiederli in fase di prenotazione. Inclusi senza costi extra.',
  },
];
---

<Layout url="/tour-sicilia" faqs={faqs} lang="it">
  <Hero
    lang="it"
    compact={true}
    h1="Tour Sicilia con Autista Privato"
    tagline="Scopri la Sicilia con un driver dedicato: itinerari su misura, Mercedes di classe e autisti professionisti."
  />

  <section class="bg-parchment-50 py-24 md:py-40">
    <div class="max-w-[1360px] mx-auto px-5 md:px-10">

      <div class="mb-6 flex items-center gap-3">
        <a href="/contatti" class="inline-flex items-center gap-2 bg-golden-bronze-500 hover:bg-golden-bronze-600 text-white font-medium px-7 py-3.5 rounded-sm transition-colors duration-200 text-base">
          Richiedi un preventivo
        </a>
      </div>

      <h2 class="font-display text-ink-black-900 font-medium text-[clamp(24px,3.5vw,44px)] leading-tight tracking-tight mt-16 mb-10">
        I nostri tour più richiesti
      </h2>

      <div class="space-y-12">
        {[
          {
            title: 'Tour Barocco – Noto, Modica, Ragusa Ibla',
            body: '6–8 ore con soste personalizzate, tempo libero e consigli locali. Possibilità di pranzo tipico o degustazione dolci.',
            details: ['Partenza: Siracusa / Noto / Ragusa', 'Consigliato: 2–6 persone', 'Mercedes V-Class / GLB'],
          },
          {
            title: 'Etna & Cantine – Wine Experience',
            body: 'Salita ai crateri Silvestri (quota 1900 m) e visita in cantina con degustazione. Possibile combinare con Taormina.',
            details: ['Partenza: Siracusa / Catania / Taormina', 'Durata: 7–9 ore', 'Opzione guida alpina su richiesta'],
          },
          {
            title: 'Ortigia & Taormina – Highlights',
            body: 'Passeggiata tra vicoli storici, terrazze panoramiche e shopping. Perfetto per famiglie e coppie.',
            details: ['Pausa pranzo vista mare', 'Tempi flessibili', 'Consigli ristoranti top'],
          },
        ].map((tour) => (
          <div class="border border-ink-black-200/40 rounded-sm p-8 md:p-10 hover:border-golden-bronze-500/40 transition-colors duration-300">
            <h3 class="font-display text-ink-black-900 font-medium text-2xl md:text-3xl tracking-tight mb-4">{tour.title}</h3>
            <p class="text-ink-black-700 text-lg leading-relaxed mb-5">{tour.body}</p>
            <ul class="space-y-2">
              {tour.details.map((d) => (
                <li class="flex items-center gap-3 text-ink-black-600 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-golden-bronze-500 flex-shrink-0"></span>
                  {d}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-16 border-t border-ink-black-200/40 pt-16">
        <h2 class="font-display text-ink-black-900 font-medium text-[clamp(24px,3vw,40px)] tracking-tight mb-8">Come funziona</h2>
        <ol class="space-y-5">
          {[
            'Ci dici data, persone e preferenze.',
            'Proponiamo un itinerario su misura con tempistiche e soste.',
            'Autista dedicato, orari flessibili, Mercedes confortevoli.',
          ].map((step, i) => (
            <li class="flex items-start gap-5 text-ink-black-700 text-lg">
              <span class="font-display text-3xl text-golden-bronze-500/50 leading-none font-light flex-shrink-0 select-none">{i + 1}</span>
              {step}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <FAQ faqs={faqs} lang="it" dark={false} />

  <!-- SEO footer links -->
  <section class="bg-deep-space-blue-950 py-12">
    <div class="max-w-[1360px] mx-auto px-5 md:px-10">
      <p class="text-parchment-200 text-sm mb-3">
        Partenze comode anche da:{' '}
        <a href="/ncc-catania" class="text-golden-bronze-400 hover:underline">NCC Catania</a>,{' '}
        <a href="/ncc-noto" class="text-golden-bronze-400 hover:underline">NCC Noto</a>,{' '}
        <a href="/ncc-taormina" class="text-golden-bronze-400 hover:underline">NCC Taormina</a>,{' '}
        <a href="/ncc-ragusa" class="text-golden-bronze-400 hover:underline">NCC Ragusa</a>.
      </p>
      <p class="text-parchment-200 text-sm">
        Per ospiti internazionali:{' '}
        <a href="/driver-catania" class="text-golden-bronze-400 hover:underline">Private Driver Catania</a>,{' '}
        <a href="/driver-noto" class="text-golden-bronze-400 hover:underline">Private Driver Noto</a>,{' '}
        <a href="/driver-taormina" class="text-golden-bronze-400 hover:underline">Private Driver Taormina</a>,{' '}
        <a href="/driver-ragusa" class="text-golden-bronze-400 hover:underline">Private Driver Ragusa</a>.
      </p>
    </div>
  </section>

  <CTAForm lang="it" />
  <WhatsAppSticky lang="it" />
</Layout>
