---
import CtaButton from './CtaButton.astro';

interface Props {
  lang?: 'it' | 'en';
}
const { lang = 'it' } = Astro.props;
const isIT = lang === 'it';

const steps = isIT
  ? [
      {
        num: '01',
        img: '/images/step-01-richiesta.webp',
        alt: 'Richiesta preventivo NCC Siracusa',
        title: 'Ci dici data, persone e preferenze',
        body: 'Scrivi via form, WhatsApp o email. Rispondiamo entro poche ore con una proposta su misura.',
      },
      {
        num: '02',
        img: '/images/step-02-itinerario.webp',
        alt: 'Itinerario personalizzato Sicilia',
        title: 'Proponiamo un itinerario personalizzato',
        body: 'Costruiamo il percorso con tempistiche, soste e consigli locali. Ogni dettaglio è concordato con te.',
      },
      {
        num: '03',
        img: '/images/step-03-autista.webp',
        alt: 'Autista NCC Mercedes Siracusa',
        title: 'Autista dedicato, Mercedes, nessun pensiero',
        body: 'Il giorno concordato il tuo autista è puntuale. Goditi la Sicilia in totale comfort, 24/7.',
      },
    ]
  : [
      {
        num: '01',
        img: '/images/step-01-richiesta.webp',
        alt: 'NCC Siracusa quote request',
        title: 'Tell us your date, party size and preferences',
        body: 'Write via form, WhatsApp or email. We reply within a few hours with a tailored proposal.',
      },
      {
        num: '02',
        img: '/images/step-02-itinerario.webp',
        alt: 'Custom Sicily itinerary',
        title: 'We design a custom itinerary',
        body: 'We build your route with timing, stops and local tips. Every detail is agreed with you.',
      },
      {
        num: '03',
        img: '/images/step-03-autista.webp',
        alt: 'Dedicated NCC driver Mercedes Sicily',
        title: 'Dedicated driver, Mercedes, zero stress',
        body: 'On the agreed day your driver is punctual. Enjoy Sicily in total comfort, 24/7.',
      },
    ];
---

<section class="bg-deep-space-blue-900 py-24 md:py-40">
  <div class="max-w-[1360px] mx-auto px-5 md:px-10">

    <!-- Section header -->
    <div class="mb-16 md:mb-20">
      <p class="text-golden-bronze-400 text-xs font-body font-medium tracking-[0.25em] uppercase mb-3">
        {isIT ? 'Il Processo' : 'How it works'}
      </p>
      <h2 class="font-display text-parchment-50 font-medium text-[clamp(28px,4vw,52px)] leading-tight tracking-tight">
        {isIT ? 'Come funziona' : 'How it works'}
      </h2>
    </div>

    <!-- Steps — desktop side by side, mobile stack -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8" id="come-funziona-steps">
      {steps.map((step, i) => (
        <div
          class="step-card border border-parchment-50/10 rounded-sm p-8 md:p-10 flex flex-col gap-6 hover:border-golden-bronze-500/40 transition-all duration-300"
          data-index={i}
        >
          <div class="relative h-48 rounded-sm overflow-hidden mb-2">
            <img
              src={step.img}
              alt={step.alt}
              class="absolute inset-0 w-full h-full object-cover object-center"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-deep-space-blue-950/30"></div>
            <span class="absolute bottom-3 right-4 font-display text-5xl font-light text-parchment-50/30 leading-none select-none" aria-hidden="true">
              {step.num}
            </span>
          </div>
          <div>
            <span class="text-golden-bronze-400 text-xs font-body font-medium tracking-[0.2em] uppercase block mb-3">
              {isIT ? `Passo ${step.num}` : `Step ${step.num}`}
            </span>
            <h3 class="font-display text-parchment-50 font-medium text-xl md:text-2xl leading-tight tracking-tight mb-4">
              {step.title}
            </h3>
            <p class="text-parchment-200 text-base leading-relaxed">
              {step.body}
            </p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <CtaButton
        label={isIT ? 'Richiedi il tuo preventivo' : 'Request your quote'}
        href={isIT ? '/contatti' : '/en/contatti'}
        variant="solid"
        size="lg"
      />
    </div>
  </div>
</section>

<script>
  const steps = document.querySelectorAll('.step-card');
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (!mediaQuery.matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const idx = parseInt(el.getAttribute('data-index') ?? '0');
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, idx * 150);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.2 }
    );

    steps.forEach((step) => {
      const el = step as HTMLElement;
      el.style.opacity = '0';
      el.style.transform = 'translateY(32px)';
      el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(el);
    });
  }
</script>
