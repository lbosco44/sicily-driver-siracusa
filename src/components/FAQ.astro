---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faqs: FaqItem[];
  lang?: 'it' | 'en';
  dark?: boolean;
}

const { faqs, lang = 'it', dark = false } = Astro.props;
---

<section class:list={['py-24 md:py-40', dark ? 'bg-deep-space-blue-950' : 'bg-parchment-50']}>
  <div class="max-w-[1360px] mx-auto px-5 md:px-10">
    <div class="max-w-3xl mx-auto">
      <p class:list={['text-xs font-body font-medium tracking-[0.25em] uppercase mb-3', dark ? 'text-golden-bronze-400' : 'text-golden-bronze-600']}>
        FAQ
      </p>
      <h2 class:list={['font-display font-medium text-[clamp(28px,4vw,48px)] leading-tight tracking-tight mb-12', dark ? 'text-parchment-50' : 'text-ink-black-900']}>
        {lang === 'it' ? 'Domande frequenti' : 'Frequently asked questions'}
      </h2>

      <div class="space-y-0" id="faq-accordion">
        {faqs.map((item, i) => (
          <div
            class:list={['faq-item border-b', dark ? 'border-parchment-50/10' : 'border-ink-black-200/40']}
            data-index={i}
          >
            <button
              class:list={[
                'w-full flex items-start justify-between gap-6 py-5 md:py-6 text-left group',
                dark ? 'text-parchment-50' : 'text-ink-black-900',
              ]}
              aria-expanded="false"
              onclick="this.closest('.faq-item').classList.toggle('open'); this.setAttribute('aria-expanded', this.closest('.faq-item').classList.contains('open') ? 'true' : 'false')"
            >
              <span class="font-display font-medium text-lg md:text-xl leading-snug tracking-tight pr-4">
                {item.q}
              </span>
              <span
                class:list={[
                  'faq-icon flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center transition-all duration-300 mt-0.5',
                  dark ? 'border border-parchment-50/20 text-golden-bronze-400' : 'border border-ink-black-200 text-golden-bronze-600',
                ]}
                aria-hidden="true"
              >
                <svg class="plus" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
                <svg class="minus hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14"/>
                </svg>
              </span>
            </button>
            <div class="faq-answer overflow-hidden max-h-0 transition-all duration-400">
              <p class:list={['pb-6 text-base leading-relaxed', dark ? 'text-parchment-200' : 'text-ink-black-700']}>
                {item.a}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-item.open .faq-answer {
    max-height: 500px;
  }
  .faq-item.open .faq-icon .plus { display: none; }
  .faq-item.open .faq-icon .minus { display: block; }
  .faq-item.open .faq-icon { background-color: rgba(196, 153, 59, 0.15); }
</style>
