---
import CtaButton from './CtaButton.astro';

interface Props {
  lang?: 'it' | 'en';
  variant?: 'light' | 'dark';
}

const { lang = 'it', variant = 'dark' } = Astro.props;

const isIT = lang === 'it';
const navLinks = isIT
  ? [
      { href: '/', label: 'Home' },
      { href: '/chi-siamo', label: 'Chi Siamo' },
      { href: '/servizi', label: 'Servizi' },
      { href: '/tour-sicilia', label: 'Tour Sicilia' },
      { href: '/tour-barocco', label: 'Tour Barocco' },
      { href: '/contatti', label: 'Contatti' },
    ]
  : [
      { href: '/en/', label: 'Home' },
      { href: '/en/chi-siamo', label: 'About Us' },
      { href: '/en/servizi', label: 'Services' },
      { href: '/en/tour-sicilia', label: 'Sicily Tours' },
      { href: '/en/tour-barocco', label: 'Baroque Tour' },
      { href: '/en/contatti', label: 'Contact' },
    ];

const langSwitch = isIT
  ? { href: '/en/', label: 'EN' }
  : { href: '/', label: 'IT' };

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  id="site-header"
  data-variant={variant}
>
  <div class="max-w-[1360px] mx-auto px-5 md:px-10 flex items-center justify-between h-16 md:h-20">
    <!-- Logo -->
    <a href={isIT ? '/' : '/en/'} class="flex-shrink-0 site-logo">
      <img
        src="/logo-text.png"
        alt="Sicily Driver Siracusa"
        width="220"
        height="44"
        class="h-10 md:h-12 w-auto logo-img"
        loading="eager"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-body font-medium tracking-wide transition-colors duration-200',
            'nav-link',
            currentPath === link.href || (link.href !== '/' && link.href !== '/en/' && currentPath.startsWith(link.href))
              ? 'nav-link-active'
              : '',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right side: lang switch + CTA -->
    <div class="flex items-center gap-4">
      <label
        class="lang-toggle hidden md:inline-block"
        aria-label={isIT ? 'Switch to English' : 'Passa all\'italiano'}
        title={isIT ? 'Switch to English' : 'Passa all\'italiano'}
      >
        <input
          type="checkbox"
          class="lang-checkbox sr-only"
          checked={isIT}
          data-target-href={langSwitch.href}
        />
        <span class="lang-slider"></span>
      </label>
      <span class="hidden md:inline-flex">
        <CtaButton
          label={isIT ? 'Preventivo' : 'Get a Quote'}
          href={isIT ? '/contatti' : '/en/contatti'}
          variant="solid"
          size="sm"
        />
      </span>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col gap-1.5 p-2 nav-link"
        aria-label="Menu"
        aria-expanded="false"
      >
        <span class="block w-6 h-px bg-current transition-all duration-300 hamburger-line"></span>
        <span class="block w-6 h-px bg-current transition-all duration-300 hamburger-line"></span>
        <span class="block w-4 h-px bg-current transition-all duration-300 hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden absolute top-full left-0 right-0 bg-deep-space-blue-950/98 backdrop-blur-md border-t border-parchment-200/10"
  >
    <nav class="max-w-[1360px] mx-auto px-5 py-6 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-parchment-50 text-lg font-body font-medium py-2 border-b border-parchment-200/10 last:border-0"
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-4 pt-2">
        <label
          class="lang-toggle"
          aria-label={isIT ? 'Switch to English' : 'Passa all\'italiano'}
        >
          <input
            type="checkbox"
            class="lang-checkbox sr-only"
            checked={isIT}
            data-target-href={langSwitch.href}
          />
          <span class="lang-slider"></span>
        </label>
        <a
          href={isIT ? 'https://wa.me/393756413379' : 'https://wa.me/393756413379'}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-golden-bronze-400 text-sm font-medium"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Transparent by default (on hero dark bg) */
  #site-header {
    background: transparent;
  }

  #site-header .nav-link {
    color: rgba(244, 238, 226, 0.85); /* lino-50 */
  }
  #site-header .nav-link:hover,
  #site-header .nav-link-active {
    color: #d4c08a; /* champagne-400 */
  }
  #site-header .cta-btn {
    background: #b8a474; /* champagne-500 */
    color: white;
  }
  #site-header .cta-btn:hover {
    background: #8a7656; /* champagne-600 */
  }

  /* Scrolled state: indaco bg */
  #site-header.scrolled {
    background: rgba(20, 18, 42, 0.985); /* indaco-950 */
    border-bottom: 1px solid rgba(212, 192, 138, 0.18); /* champagne-400 */
  }

  /* Light variant (for parchment/lino pages) */
  #site-header[data-variant="light"] .nav-link {
    color: rgba(42, 36, 25, 0.78); /* ink-warm-900 */
  }
  #site-header[data-variant="light"] .nav-link:hover,
  #site-header[data-variant="light"] .nav-link-active {
    color: #8a7656; /* champagne-600 */
  }
  #site-header[data-variant="light"].scrolled {
    background: rgba(244, 238, 226, 0.97); /* lino-50 */
    border-bottom: 1px solid rgba(42, 36, 25, 0.12); /* ink-warm-900 */
  }

  /* Language toggle (Uiverse-style) — flag-circle slides between IT/EN */
  .lang-toggle {
    position: relative;
    width: 64px;
    height: 32px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .lang-slider {
    position: absolute;
    inset: 0;
    background: rgba(20, 18, 42, 0.6); /* indaco-950 */
    border: 1px solid rgba(212, 192, 138, 0.5); /* champagne-400 */
    border-radius: 999px;
    transition: background 0.3s, border-color 0.3s;
  }
  .lang-slider::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-image: url('/images/flag-it.png');
    background-size: cover;
    background-position: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform;
  }
  .lang-checkbox:checked + .lang-slider::before {
    transform: translateX(32px);
    background-image: url('/images/flag-en.png');
  }

  /* Page fade during language switch */
  body.lang-switching {
    transition: opacity 0.25s ease;
    opacity: 0;
    pointer-events: none;
  }
  .lang-toggle:hover .lang-slider {
    border-color: rgba(212, 192, 138, 0.8); /* champagne-400 */
  }
  #site-header[data-variant="light"] .lang-slider {
    background: rgba(20, 18, 42, 0.88); /* indaco-950 su lino */
  }

  /* Logo: PNG transparente, black text. Invert solo su sfondo scuro per renderlo bianco. */
  .site-logo .logo-img {
    filter: invert(1);
  }
  #site-header[data-variant="light"] .site-logo .logo-img,
  #site-header.scrolled[data-variant="light"] .site-logo .logo-img {
    filter: none;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll state
  function updateHeader() {
    if (!header) return;
    if (window.scrollY > 60) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;
    mobileMenu?.classList.toggle('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Language toggle: animate, fade page out, then navigate
  let langSwitching = false;
  document.querySelectorAll<HTMLInputElement>('.lang-checkbox').forEach((cb) => {
    cb.addEventListener('change', (e) => {
      if (langSwitching) {
        e.preventDefault();
        return;
      }
      const target = cb.dataset.targetHref;
      if (!target) return;
      langSwitching = true;
      // Mirror the change across all toggles (desktop + mobile)
      document.querySelectorAll<HTMLInputElement>('.lang-checkbox').forEach((c) => {
        if (c !== cb) c.checked = cb.checked;
      });
      // Let the slider animation complete (~280ms), then fade out and navigate
      setTimeout(() => {
        document.body.classList.add('lang-switching');
        setTimeout(() => { window.location.href = target; }, 220);
      }, 280);
    });
  });
</script>
