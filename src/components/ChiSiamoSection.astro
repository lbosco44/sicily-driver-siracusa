---
interface Props {
  lang?: 'it' | 'en';
}
const { lang = 'it' } = Astro.props;
const isIT = lang === 'it';
---

<section class="bg-parchment-50 py-24 md:py-40">
  <div class="max-w-[1360px] mx-auto px-5 md:px-10">

    <!-- Section header -->
    <div class="flex items-baseline gap-6 mb-16 md:mb-20">
      <span class="font-display text-[80px] md:text-[120px] font-light text-ink-black-950/20 leading-none select-none" aria-hidden="true">03</span>
      <div>
        <p class="text-golden-bronze-600 text-xs font-body font-medium tracking-[0.25em] uppercase mb-2">
          {isIT ? 'Chi Siamo' : 'About Us'}
        </p>
        <h2 class="font-display text-ink-black-900 font-medium text-[clamp(28px,4vw,52px)] leading-tight tracking-tight">
          {isIT ? 'La nostra storia' : 'Our Story'}
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center">
      <!-- Image -->
      <div class="relative overflow-hidden rounded-sm">
        <picture>
          <source
            media="(min-width: 768px)"
            srcset="/images/chi-siamo-desktop.webp"
            type="image/webp"
          />
          <source
            srcset="/images/chi-siamo-mobile.webp"
            type="image/webp"
          />
          <img
            src="/images/chi-siamo-desktop.webp"
            alt={isIT ? 'Il team di Sicily Driver Siracusa' : 'Sicily Driver Syracuse team'}
            class="w-full aspect-[4/3] md:aspect-[3/4] object-cover object-center"
            loading="lazy"
          />
        </picture>
        <!-- Decorative border -->
        <div class="absolute -bottom-4 -right-4 w-full h-full border border-golden-bronze-400/30 rounded-sm pointer-events-none hidden md:block"></div>
      </div>

      <!-- Text -->
      <div>
        <p class="text-ink-black-700 text-lg md:text-xl leading-relaxed mb-6">
          {isIT
            ? 'Sicily Driver Syracuse è una realtà giovane e dinamica, nata dalla passione per i servizi di NCC e transfer di alta qualità. Con una solida esperienza maturata nell\'organizzazione di percorsi personalizzati, offriamo soluzioni su misura per privati e aziende che desiderano viaggiare con comfort e sicurezza.'
            : 'Sicily Driver Syracuse is a young and dynamic company born from a passion for high-quality NCC and transfer services. With extensive experience in crafting personalized journeys, we provide tailored solutions for individuals and businesses seeking comfort and safety in their travels.'}
        </p>
        <p class="text-ink-black-700 text-lg leading-relaxed mb-8">
          {isIT
            ? 'Grazie al nostro parco auto selezionato e all\'attenzione al dettaglio, garantiamo puntualità e cortesia in ogni spostamento. Il nostro team è formato da professionisti del trasporto che conoscono a fondo le esigenze dei clienti, pronti a supportarti 24/7 durante il tuo viaggio.'
            : 'Thanks to our carefully selected fleet and attention to detail, we guarantee punctuality and courtesy on every trip. Our team consists of transportation professionals who understand the specific needs of our clients, ready to support you 24/7 throughout your journey.'}
        </p>

        <!-- Fleet highlight -->
        <div class="border-l-2 border-golden-bronze-500 pl-6 mb-8">
          <p class="font-display text-ink-black-900 text-2xl font-medium tracking-tight mb-1">Mercedes Classe V, GLB Premium, Classe E</p>
          <p class="text-ink-black-500 text-sm">{isIT ? 'La nostra flotta premium' : 'Our premium fleet'}</p>
        </div>

        <a
          href={isIT ? '/contatti' : '/en/contatti'}
          class="inline-flex items-center gap-2 bg-deep-space-blue-900 hover:bg-deep-space-blue-800 text-parchment-50 font-medium px-7 py-4 rounded-sm transition-colors duration-200"
        >
          {isIT ? 'Contattaci' : 'Contact Us'}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
