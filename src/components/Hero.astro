---
import HeroFadeOut from './react/HeroFadeOut';
import CtaButton from './CtaButton.astro';

interface Props {
  lang?: 'it' | 'en';
  h1?: string;
  tagline?: string;
  motto?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  compact?: boolean;
}

const {
  lang = 'it',
  h1 = 'Sicily Driver Siracusa',
  tagline,
  motto,
  ctaPrimary,
  ctaSecondary,
  compact = false,
} = Astro.props;
---

<section
  id="hero-section"
  class:list={[
    'relative overflow-hidden bg-deep-space-blue-950',
    compact ? 'min-h-[50vh]' : 'min-h-screen',
  ]}
>
  <!-- Background image with Ken Burns -->
  <picture class="absolute inset-0 w-full h-full">
    <source
      media="(min-width: 768px)"
      srcset="/images/hero-desktop.webp"
      type="image/webp"
    />
    <source
      srcset="/images/hero-mobile.webp"
      type="image/webp"
    />
    <img
      src="/images/hero-desktop.webp"
      alt={lang === 'it' ? 'Mercedes Classe V a Siracusa, Sicilia' : 'Mercedes V-Class in Syracuse, Sicily'}
      class="ken-burns absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-deep-space-blue-950/40 via-deep-space-blue-950/20 to-deep-space-blue-950/80"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-deep-space-blue-950/60 via-transparent to-transparent"></div>

  <!-- Content (centered, vertical) -->
  <div class="relative z-10 flex flex-col justify-center min-h-screen px-5 md:px-10 max-w-[1360px] mx-auto">
    {!compact && (
      <div class="max-w-5xl" style="animation: fadeUp 1.2s ease-out both;">
        {tagline && (
          <p class="text-golden-bronze-400 text-xs md:text-sm font-body font-medium tracking-[0.3em] uppercase mb-7 opacity-90">
            {tagline}
          </p>
        )}
        <h1 class="font-display text-white font-medium leading-[0.95] mb-6 md:mb-8 text-[clamp(48px,10vw,128px)] tracking-tight">
          {h1}
        </h1>
        {motto && (
          <p class="hero-motto font-display italic text-[clamp(20px,2.4vw,32px)] leading-tight mb-10 max-w-3xl">
            <span class="hero-motto-text">{motto}</span>
          </p>
        )}
        <div class="flex flex-col sm:flex-row gap-4">
          {ctaPrimary && (
            <CtaButton label={ctaPrimary.label} href={ctaPrimary.href} variant="primary" size="lg" />
          )}
          {ctaSecondary && (
            <CtaButton label={ctaSecondary.label} href={ctaSecondary.href} variant="outline" size="lg" />
          )}
        </div>
      </div>
    )}
    {compact && (
      <div class="max-w-3xl" style="animation: fadeUp 0.8s ease-out both;">
        <h1 class="font-display text-white font-medium leading-[1.0] text-[clamp(36px,6vw,80px)] tracking-tight mb-4">
          {h1}
        </h1>
        {tagline && (
          <p class="text-parchment-100 text-lg font-body leading-relaxed max-w-2xl">
            {tagline}
          </p>
        )}
      </div>
    )}
  </div>

  <!-- Scroll indicator (hidden on compact) -->
  {!compact && (
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-60">
      <div class="w-px h-12 bg-gradient-to-b from-parchment-50 to-transparent animate-pulse"></div>
    </div>
  )}
</section>

<HeroFadeOut client:load />

<style>
  .ken-burns {
    animation: kenBurns 20s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* Motto with gold shimmer sweep */
  .hero-motto {
    color: rgba(249, 244, 236, 0.92);
    letter-spacing: 0.005em;
    animation: mottoFade 1.6s ease-out 0.25s both;
  }
  .hero-motto-text {
    background: linear-gradient(
      100deg,
      rgba(249, 244, 236, 0.85) 0%,
      rgba(249, 244, 236, 0.85) 35%,
      #e6c374 50%,
      rgba(249, 244, 236, 0.85) 65%,
      rgba(249, 244, 236, 0.85) 100%
    );
    background-size: 220% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: mottoShimmer 5.5s ease-in-out 1.5s infinite;
  }

  @keyframes mottoFade {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes mottoShimmer {
    0%   { background-position: 200% 0; }
    50%  { background-position: -100% 0; }
    100% { background-position: -100% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ken-burns { animation: none; }
    .hero-motto-text { animation: none; -webkit-text-fill-color: rgba(249, 244, 236, 0.92); color: rgba(249, 244, 236, 0.92); }
    .hero-motto { animation: none; }
  }
</style>
